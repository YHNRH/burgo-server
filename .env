# Сервер
HTTP_PORT=3001
UDP_PORT=41235
UDP_BROADCAST=192.168.1.255

# База данных
DB_HOST=localhost
DB_USER=user
DB_PASSWORD=secret
DB_NAME=burgo

# API ключи (для погоды и др.)
OPENWEATHER_API_KEY=your_key_here

# Путь к Python-интерпретатору (виртуальное окружение)
PYTHON_PATH=./venv/bin/python

# Настройки TTS
TTS_VOICE=anna
TTS_QUALITY=min
TTS_TARGET_RATE=44100